{
  "name": "tikz-wasm",
  "version": "0.0.1",
  "description": "Zero-dependency, in-browser LaTeX TikZ to SVG compiler via WebAssembly.",
  "type": "module",
  "files": [
    "dist",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "README.md"
  ],
  "main": "./dist/tikz-wasm.umd.js",
  "module": "./dist/tikz-wasm.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/tikz-wasm.es.js",
      "require": "./dist/tikz-wasm.umd.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "setup": "tsx scripts/setup.ts",
    "build:fmt": "tsx scripts/build_fmt.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --emitDeclarationOnly && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview"
  },
  "author": "Samuel Marks",
  "license": "(Apache-2.0 OR MIT)",
  "homepage": "https://github.com/SamuelMarks/tikz-wasm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamuelMarks/tikz-wasm.git"
  },
  "bugs": {
    "url": "https://github.com/SamuelMarks/tikz-wasm/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "esbuild": "^0.27.2",
    "glob": "^13.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  }
}